@using System.Security.Claims
@{
    var layoutRole = User.Identity != null && User.Identity.IsAuthenticated
        ? User.FindFirst(ClaimTypes.Role)?.Value
        : null;
    var roleClass = layoutRole switch
    {
        "Client" => "role-client",
        "Delivery" => "role-delivery",
        "Admin" => "role-admin",
        _ => "role-guest"
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FlashBite Delivery</title>
    <!-- Tipografía del sistema: IBM Plex Sans (700 títulos / 600 subtítulos / 400 cuerpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@roleClass">
    <header>
        <partial name="_Navbar" />
    </header>
    <div class="container main-container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <p class="mb-0 font-title">FlashBite Delivery System</p>
            <p class="text-muted small mb-0">&copy; 2026 FlashBite. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Iconografía: Lucide (usar <i data-lucide="nombre"></i>) -->
    <script src="https://unpkg.com/lucide@0.462.0/dist/umd/lucide.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        if (window.lucide) { lucide.createIcons(); }
    </script>
</body>
</html>
