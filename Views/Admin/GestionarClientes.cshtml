@model List<delivery_system_dotnet.Models.ClienteItemViewModel>
@{
    ViewData["Title"] = "Gestión de Clientes - FlashBite";
}

<div class="container mt-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="section-heading m-0">Clientes (@Model.Count)</h4>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["Error"]</div>
    }

    <div class="dashboard-card">
        <div class="table-responsive">
            <table class="table table-delivery align-middle m-0">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Contacto</th>
                        <th>Dirección</th>
                        <th class="text-center">Pedidos</th>
                        <th class="text-end">Total gastado</th>
                        <th>Cuenta</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Client.Name</strong>
                                    <div class="text-muted small">@item.Client.Dni</div>
                                </td>
                                <td>
                                    <div class="small">@item.Client.Mail</div>
                                    <div class="text-muted small">@item.Client.Phone</div>
                                </td>
                                <td class="text-muted" style="max-width: 220px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item.Client.Address</td>
                                <td class="text-center">@item.Pedidos</td>
                                <td class="text-end" style="font-variant-numeric: tabular-nums;">$@item.TotalGastado.ToString("F2")</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge-delivery badge-delivery-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge-delivery badge-delivery-danger">Suspendido</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form method="post" action="/Admin/ResetearPassword" class="d-inline"
                                          onsubmit="return confirm('¿Resetear la contraseña de @item.Client.Name? Se generará una contraseña temporal que deberás entregarle.');">
                                        <input type="hidden" name="dni" value="@item.Client.Dni" />
                                        <button type="submit" class="btn btn-sm btn-delivery-outline" title="Generar una contraseña temporal para este cliente">
                                            <i data-lucide="key-round"></i> Resetear contraseña
                                        </button>
                                    </form>
                                    <form method="post" action="/Admin/CambiarEstadoCliente" class="d-inline"
                                          onsubmit="return confirm('@(item.Activo ? "¿Suspender" : "¿Activar") a @item.Client.Name?');">
                                        <input type="hidden" name="dni" value="@item.Client.Dni" />
                                        <input type="hidden" name="activar" value="@((!item.Activo).ToString().ToLower())" />
                                        @if (item.Activo)
                                        {
                                            <button type="submit" class="btn btn-sm btn-destructive">
                                                <i data-lucide="user-x"></i> Suspender
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-delivery-primary">
                                                <i data-lucide="user-check"></i> Activar
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state" style="border: none;">
                                    <i data-lucide="users" class="empty-state-icon" style="width:32px;height:32px;"></i>
                                    <h5>No hay clientes registrados</h5>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
