@model List<delivery_system_dotnet.Models.Products>
@{
    ViewData["Title"] = "Manage Products - FlashBite";
}

<div class="container mt-4 animate-fade-in">
    <div class="dashboard-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="font-title text-danger mb-1">Manage Products</h1>
            <p class="text-muted mb-0">Control the menu catalog, update safety stock and assign categories.</p>
        </div>
        <a href="/Admin/GestionarProductos" class="btn btn-delivery-outline btn-sm">Vista clásica (ES)</a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 text-center mb-4">
            @TempData["Message"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 text-center mb-4">
            @TempData["Error"]
        </div>
    }

    <div class="card card-flash border">
        <div class="card-body">
            <h5 class="card-title text-danger mb-3 border-bottom pb-2 font-title">Product Catalog</h5>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Restaurant</th>
                            <th>Price</th>

                            <th>Category</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.Name</strong></td>
                                    <td><span class="text-muted small">@(item.Restaurant != null ? item.Restaurant.Name : "—")</span></td>
                                    <td>$@item.Price.ToString("F2")</td>
                                    <td>
                                        <form method="post" action="/Admin/AssignCategory" class="d-flex align-items-center gap-2">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="text" name="category" value="@item.Category" class="form-control form-control-sm" style="width: 150px;" required />
                                            <button type="submit" class="btn btn-sm btn-delivery-outline py-1">Assign</button>
                                        </form>
                                    </td>
                                    <td>
                                        <form method="post" action="/Admin/DeleteProduct" onsubmit="return confirm('Are you sure you want to delete this product?')" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-destructive py-1">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No products found in the database.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
