@model List<delivery_system_dotnet.Models.Restaurant>
@{
    ViewData["Title"] = "Gestionar Restaurantes - FlashBite";
}

<div class="container mt-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="section-heading m-0">Restaurantes (@Model.Count)</h4>
        <div class="d-flex gap-2">
            <a href="/Admin/CreateProduct" class="btn btn-delivery-outline btn-sm">
                <i data-lucide="plus"></i> Nuevo producto
            </a>
            <a href="/Admin/CreateRestaurant" class="btn btn-delivery-primary btn-sm">
                <i data-lucide="store"></i> Nuevo restaurante
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["Message"]</div>
    }

    <div class="dashboard-card">
        <div class="table-responsive">
            <table class="table table-delivery m-0">
                <thead>
                    <tr>
                        <th style="width: 56px;"></th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th>Horario</th>
                        <th class="text-center">Productos</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var rest in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@rest.ImagePath" alt="@rest.Name"
                                         style="width: 40px; height: 40px; object-fit: cover; border: 1px solid var(--fb-border);"
                                         onerror="this.style.visibility='hidden'" />
                                </td>
                                <td class="fw-bold">@rest.Name</td>
                                <td>@rest.Category</td>
                                <td class="text-muted" style="max-width: 220px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@rest.Address</td>
                                <td>@rest.Phone</td>
                                <td style="white-space: nowrap;">@rest.OpeningHour.ToString(@"hh\:mm") – @rest.ClosingHour.ToString(@"hh\:mm")</td>
                                <td class="text-center">
                                    <a href="/Admin/GestionarProductos" title="Ver catálogo">@rest.Products.Count</a>
                                </td>
                                <td>
                                    @if (rest.IsActive)
                                    {
                                        <span class="badge-delivery badge-delivery-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge-delivery badge-delivery-danger">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end" style="white-space: nowrap;">
                                    <a href="/Admin/CreateProduct?restaurantId=@rest.Id" class="btn btn-delivery-outline btn-sm" title="Agregar producto a este restaurante">
                                        <i data-lucide="plus"></i>
                                    </a>
                                    <a href="/Admin/EditRestaurant?id=@rest.Id" class="btn btn-delivery-outline btn-sm" title="Editar">
                                        <i data-lucide="pencil"></i>
                                    </a>
                                    <form method="post" action="/Admin/ToggleRestaurante" class="d-inline"
                                          onsubmit="return confirm('@(rest.IsActive ? "¿Desactivar" : "¿Activar") @rest.Name?');">
                                        <input type="hidden" name="id" value="@rest.Id" />
                                        <button type="submit" class="btn @(rest.IsActive ? "btn-destructive" : "btn-delivery-outline") btn-sm"
                                                title="@(rest.IsActive ? "Desactivar" : "Activar")">
                                            <i data-lucide="@(rest.IsActive ? "eye-off" : "eye")"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9">
                                <div class="empty-state" style="border: none;">
                                    <i data-lucide="store" class="empty-state-icon" style="width: 32px; height: 32px;"></i>
                                    <h5>No hay restaurantes registrados</h5>
                                    <p class="mb-0">Crea el primero con el botón "Nuevo restaurante".</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
