@model List<delivery_system_dotnet.Models.RepartidorItemViewModel>
@{
    ViewData["Title"] = "Gestión de Repartidores - FlashBite";
    var pendientes = Model.Count(r => !r.Activo);
}

<div class="container mt-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="section-heading m-0">Repartidores (@Model.Count)</h4>
        @if (pendientes > 0)
        {
            <span class="badge-delivery badge-delivery-warning">@pendientes pendiente(s) de aprobación</span>
        }
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["Error"]</div>
    }

    <div class="dashboard-card">
        <div class="table-responsive">
            <table class="table table-delivery align-middle m-0">
                <thead>
                    <tr>
                        <th>Repartidor</th>
                        <th>Contacto</th>
                        <th>Vehículo</th>
                        <th>Placa</th>
                        <th class="text-center">Rating</th>
                        <th class="text-center">Entregas</th>
                        <th class="text-end">Ganancias</th>
                        <th>Disponibilidad</th>
                        <th>Cuenta</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Delivery.Name</strong>
                                    <div class="text-muted small">@item.Delivery.Dni</div>
                                </td>
                                <td>
                                    <div class="small">@item.Delivery.Mail</div>
                                    <div class="text-muted small">@item.Delivery.Phone</div>
                                </td>
                                <td>@item.Delivery.TypeVehicle</td>
                                <td>@item.Delivery.LicensePlate</td>
                                <td class="text-center" style="color: var(--fb-warning); font-weight: 600;">@item.Delivery.Rating.ToString("F1") ★</td>
                                <td class="text-center">@item.EntregasCompletadas</td>
                                <td class="text-end" style="font-variant-numeric: tabular-nums;">$@item.Ganancias.ToString("F2")</td>
                                <td>
                                    <span class="badge-delivery @(item.Delivery.Status ? "badge-delivery-info" : "badge-delivery-warning")">
                                        @(item.Delivery.Status ? "Disponible" : "Ocupado")
                                    </span>
                                </td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge-delivery badge-delivery-success">Aprobado</span>
                                    }
                                    else
                                    {
                                        <span class="badge-delivery badge-delivery-warning">Pendiente</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form method="post" action="/Admin/ResetearPassword" class="d-inline"
                                          onsubmit="return confirm('¿Resetear la contraseña de @item.Delivery.Name? Se generará una contraseña temporal que deberás entregarle.');">
                                        <input type="hidden" name="dni" value="@item.Delivery.Dni" />
                                        <button type="submit" class="btn btn-sm btn-delivery-outline" title="Generar una contraseña temporal para este repartidor">
                                            <i data-lucide="key-round"></i> Resetear contraseña
                                        </button>
                                    </form>
                                    <form method="post" action="/Admin/CambiarEstadoRepartidor" class="d-inline"
                                          onsubmit="return confirm('@(item.Activo ? "¿Suspender" : "¿Aprobar") a @item.Delivery.Name?');">
                                        <input type="hidden" name="dni" value="@item.Delivery.Dni" />
                                        <input type="hidden" name="activar" value="@((!item.Activo).ToString().ToLower())" />
                                        @if (item.Activo)
                                        {
                                            <button type="submit" class="btn btn-sm btn-destructive">
                                                <i data-lucide="user-x"></i> Suspender
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-delivery-primary">
                                                <i data-lucide="user-check"></i> Aprobar vehículo
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10">
                                <div class="empty-state" style="border: none;">
                                    <i data-lucide="bike" class="empty-state-icon" style="width:32px;height:32px;"></i>
                                    <h5>No hay repartidores registrados</h5>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
