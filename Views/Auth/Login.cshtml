@{
    ViewData["Title"] = "Iniciar sesión - FlashBite";
}

<div class="auth-split-container animate-fade-in">
    <!-- Formulario (Lado Izquierdo) -->
    <div class="auth-panel-form">
        <div class="d-flex align-items-center mb-4">
            <span class="brand-bolt me-2" style="font-size: 20px; width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M5.52.359A.5.5 0 0 1 6 0h4a.5.5 0 0 1 .474.658L8.694 6H12.5a.5.5 0 0 1 .395.807l-7 9a.5.5 0 0 1-.873-.454L6.823 9.5H3.5a.5.5 0 0 1-.48-.641l2.5-8.5z"/></svg>            </span>
            <h2 class="m-0 font-title font-weight-bold" style="color: var(--fb-primary);">FlashBite</h2>
        </div>

        <h3 class="mb-1 font-title">Bienvenido de nuevo</h3>
        <p class="text-muted mb-4">Inicia sesión para pedir la comida que te encanta.</p>

        @if (ViewBag.Error != null && !string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="alert alert-danger border-0 bg-danger text-white rounded-3 mb-4 py-3" role="alert">
                <strong>¡Oops!</strong> @ViewBag.Error
            </div>
        }
        @if (ViewBag.Info != null && !string.IsNullOrEmpty(ViewBag.Info))
        {
            <div class="alert alert-success border-0 bg-success text-white rounded-3 mb-4 py-3" role="alert">
                <strong>¡Perfecto!</strong> @ViewBag.Info
            </div>
        }

        <form method="post" action="/Auth/Login">
            <div class="mb-3">
                <label for="email" class="form-label font-weight-bold mb-2">Correo electrónico</label>
                <input type="email" class="form-control auth-pill-input w-100" id="email" name="email" required placeholder="correo@ejemplo.com" />
            </div>
            <div class="mb-4">
                <div class="d-flex justify-content-between mb-2">
                    <label for="password" class="form-label font-weight-bold mb-0">Contraseña</label>
                    <a href="/Auth/RecuperarPassword" class="text-danger small text-decoration-none font-weight-bold">¿La olvidaste?</a>
                </div>
                <input type="password" class="form-control auth-pill-input w-100" id="password" name="password" required placeholder="••••••" />
            </div>
            
            <button type="submit" class="btn btn-delivery-primary w-100 btn-lg rounded-pill py-3 font-weight-bold shadow mb-3 mt-2">
                Iniciar sesión
            </button>
        </form>

        <div class="text-center mt-3 pt-3 border-top d-flex flex-wrap justify-content-center gap-3 align-items-center">
            <div>
                <span class="text-muted small">¿Nuevo en FlashBite?</span>
                <a href="/Auth/Registro" class="text-danger small font-weight-bold text-decoration-none ms-1">Regístrate hoy</a>
            </div>
            <div class="text-muted d-none d-sm-inline">|</div>
            <div>
                <a href="/Auth/DesbloquearCuenta" class="text-danger small font-weight-bold text-decoration-none">Desbloquear cuenta</a>
            </div>
        </div>
    </div>

    <!-- Ilustración (Lado Derecho) -->
    <div class="auth-panel-illustration text-center">
        <span class="auth-illustration-emoji"><i data-lucide="zap" style="width: 48px; height: 48px;"></i></span>
        <h4 class="font-title text-dark mb-2">La comida que quieres</h4>
        <p class="text-muted max-width-xs mx-auto small">Encuentra los mejores restaurantes y recíbelo todo en la comodidad de tu hogar.</p>
    </div>
</div>
