@{
    ViewData["Title"] = "Verificación OTP - FlashBite";
}

<div class="split-container animate-fade-in">
    <!-- Formulario (Lado Izquierdo) -->
    <div class="split-form-panel">
        <div class="mb-4">
            <a href="/Auth/Login" class="text-danger small text-decoration-none">&larr; Volver al Login</a>
        </div>
        
        <div class="mb-4">
            <h2 class="font-title text-danger">Ingresar Código OTP</h2>
            <p class="text-muted">
                Hemos enviado un código OTP de 6 dígitos a la dirección de correo: <br>
                <strong class="text-dark">@ViewBag.Email</strong>
            </p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 bg-danger text-white rounded-3 mb-4" role="alert">
                <strong>¡Error!</strong> @ViewBag.Error
            </div>
        }

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-success border-0 rounded-3 mb-4" role="alert">
                @TempData["Info"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger border-0 bg-danger text-white rounded-3 mb-4" role="alert">
                <strong>¡Error!</strong> @TempData["Error"]
            </div>
        }

        <form method="post" action="/Auth/VerificarCodigo">
            <div class="mb-4">
                <label for="codigo" class="form-label d-block mb-2">Código de Verificación (6 dígitos)</label>
                <!-- Usamos una caja de entrada para el código -->
                <input type="text" class="form-control text-center" 
                       id="codigo" name="codigo" required maxlength="6" autofocus placeholder="000000" 
                       style="letter-spacing: 8px; font-size: 24px; font-weight: bold; color: #e63946; max-width: 250px; margin: 0 auto;" />
                <div class="form-text text-center mt-2 small text-muted">El código expira en 10 minutos y puede usarse una sola vez.</div>
            </div>
            
            <button type="submit" class="btn btn-flashbite-primary w-100 btn-lg shadow-sm">
                Confirmar Verificación
            </button>
        </form>

        <div class="text-center mt-3 small text-muted">
            ¿No recibiste el código?
            <a href="/Auth/ReenviarCodigo" class="text-danger fw-semibold text-decoration-none">Reenviar código</a>
        </div>
    </div>

    <!-- Ilustración (Lado Derecho) -->
    <div class="split-image-panel">
        <span class="auth-illustration-emoji"><i data-lucide="zap" style="width: 48px; height: 48px;"></i></span>
    </div>
</div>
