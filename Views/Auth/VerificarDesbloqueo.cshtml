@{
    ViewData["Title"] = "Verificar Desbloqueo - FlashBite";
}

<div class="split-container animate-fade-in">
    <div class="split-form-panel">
        <div class="d-flex align-items-center mb-4">
            <div class="brand-badge me-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M5.52.359A.5.5 0 0 1 6 0h4a.5.5 0 0 1 .474.658L8.694 6H12.5a.5.5 0 0 1 .395.807l-7 9a.5.5 0 0 1-.873-.454L6.823 9.5H3.5a.5.5 0 0 1-.48-.641l2.5-8.5z"/>
                </svg>
            </div>
            <h2 class="m-0 font-title font-weight-bold">FlashBite</h2>
        </div>

        <h3 class="mb-1 font-title">Confirmar Código de Desbloqueo</h3>
        <p class="text-muted small mb-4">Ingresa el código OTP enviado a tu correo <strong>@ViewBag.Email</strong>.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 bg-danger text-white rounded-3 mb-4" role="alert">
                <strong>¡Error!</strong> @ViewBag.Error
            </div>
        }

        <form method="post" action="/Auth/VerificarDesbloqueo">
            <div class="mb-4">
                <label class="form-label">Código OTP (6 dígitos)</label>
                <input type="text" class="form-control text-center font-title h3 mb-0 text-danger" name="codigo" required maxlength="6" placeholder="000000" style="letter-spacing: 5px;" />
            </div>
            <button type="submit" class="btn btn-flashbite-primary w-100 btn-lg shadow-sm mb-3">
                Verificar y desbloquear
            </button>
            <div class="text-center">
                <a href="/Auth/DesbloquearCuenta" class="text-danger small font-weight-bold text-decoration-none">Solicitar nuevo código</a>
            </div>
        </form>
    </div>

    <div class="split-image-panel">
        <span class="auth-illustration-emoji"><i data-lucide="zap" style="width: 48px; height: 48px;"></i></span>
    </div>
</div>
