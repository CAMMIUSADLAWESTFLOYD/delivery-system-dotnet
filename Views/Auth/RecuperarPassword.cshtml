@{
    ViewData["Title"] = "Recuperar Contraseña - FlashBite";
}

<div class="split-container animate-fade-in">
    <!-- Formulario (Lado Izquierdo) -->
    <div class="split-form-panel">
        <div class="mb-4">
            <a href="/Auth/Login" class="text-danger small text-decoration-none">&larr; Volver al Login</a>
        </div>
        
        <div class="mb-4">
            <h2 class="font-title text-danger">¿Olvidaste tu contraseña?</h2>
            <p class="text-muted">Ingresa tu correo y te enviaremos un código OTP para restablecer tu contraseña.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 bg-danger text-white rounded-3 mb-4" role="alert">
                <strong>¡Error!</strong> @ViewBag.Error
            </div>
        }

        <form method="post" action="/Auth/RecuperarPassword">
            <div class="mb-4">
                <label for="email" class="form-label">Correo electrónico</label>
                <input type="email" class="form-control" id="email" name="email" required placeholder="correo@ejemplo.com" />
            </div>
            
            <button type="submit" class="btn btn-flashbite-primary w-100 btn-lg shadow-sm mb-3">
                Enviar Código
            </button>
        </form>
    </div>

    <!-- Ilustración (Lado Derecho) -->
    <div class="split-image-panel">
        <span class="auth-illustration-emoji"><i data-lucide="zap" style="width: 48px; height: 48px;"></i></span>
    </div>
</div>
