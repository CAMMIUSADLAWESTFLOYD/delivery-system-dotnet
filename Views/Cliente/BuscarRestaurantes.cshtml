@model List<delivery_system_dotnet.Models.Restaurant>
@{
    ViewData["Title"] = "Restaurantes - FlashBite";
    var categorias = ViewBag.Categorias as List<string> ?? new List<string>();
}

<div class="container mt-3 animate-fade-in">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="section-heading" style="margin-bottom: 8px;">Explora Restaurantes</h2>
            <p class="text-muted mb-0" style="padding-left: 16px;">Busca por nombre o filtra por categoria y descubre su menu.</p>
        </div>
        <a href="/Cliente/BuscarProductos" class="btn btn-delivery-outline btn-sm">Buscar Productos</a>
    </div>

    <!-- Filtro de categorias -->
    <div class="row mb-4">
        <div class="col-md-12 d-flex flex-wrap justify-content-center gap-2">
            <a href="/Cliente/BuscarRestaurantes" 
               class="btn btn-sm @(string.IsNullOrEmpty(ViewBag.Category as string) ? "btn-delivery-primary text-white" : "btn-light border text-dark") px-4 py-2 rounded-pill" 
               style="font-weight: 700; font-size: 13px;">
                Todos
            </a>
            @foreach (var cat in categorias)
            {
                <a href="/Cliente/BuscarRestaurantes?category=@Uri.EscapeDataString(cat)" 
                   class="btn btn-sm @((ViewBag.Category as string) == cat ? "btn-delivery-primary text-white" : "btn-light border text-dark") px-4 py-2 rounded-pill"
                   style="font-weight: 700; font-size: 13px;">
                    @cat
                </a>
            }
        </div>
    </div>

    <!-- Buscador por nombre -->
    <form method="get" action="/Cliente/BuscarRestaurantes" class="row g-2 mb-5 justify-content-center">
        <input type="hidden" name="category" value="@ViewBag.Category" />
        <div class="col-md-7">
            <div class="input-group search-bar-pill w-100">
                <span class="input-group-text bg-light border-0 ps-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-search text-muted" viewBox="0 0 16 16">
                      <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                    </svg>
                </span>
                <input type="text" name="search" class="form-control bg-light border-0 py-2" placeholder="Buscar restaurante por nombre..." value="@ViewBag.Search" />
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-delivery-primary w-100 py-2">Buscar</button>
        </div>
    </form>

    <!-- Grilla de restaurantes -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var rest in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <a href="/Cliente/DetalleRestaurante?id=@rest.Id" class="restaurant-card text-decoration-none">
                        <div class="restaurant-img-wrapper">
                            <img src="@rest.ImagePath" alt="@rest.Name" loading="lazy"
                                 class="restaurant-logo"
                                 onerror="this.style.display='none'" />
                        </div>
                        <div class="restaurant-info">
                            <h6 class="font-title mb-1">@rest.Name</h6>
                            <p class="text-muted small mb-1">@rest.Address</p>
                            <p class="text-muted small mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@rest.Description</p>
                            @if (!string.IsNullOrEmpty(rest.Category))
                            {
                                <span class="badge-delivery badge-delivery-info mb-2">@rest.Category</span>
                            }
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2" style="border-top: 1px solid var(--fb-border-color);">
                                <span class="restaurant-rating">4.9</span>
                                <span style="color: var(--fb-primary); font-weight: 700; font-size: 13px;">Ver menu &rarr;</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="empty-state">
                    <h5>No se encontraron restaurantes</h5>
                    <p>Intenta con otra busqueda o categoria diferente.</p>
                    <a href="/Cliente/BuscarRestaurantes" class="btn btn-delivery-primary mt-3">Ver todos los restaurantes</a>
                </div>
            </div>
        }
    </div>
</div>
