{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // SQL Server estándar (SSMS). Si tu servidor NO es "localhost", cambia SOLO la parte "Server=..."
    // por el nombre de tu instancia, por ejemplo:  Server=DESKTOP-XXXXX\\SQLEXPRESS  o  Server=.\\SQLEXPRESS
    // (usa doble barra invertida \\ para las instancias con nombre).
    "DefaultConnection": "Server=localhost;Database=FlashBiteDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "SmtpSettings": {
    "Server": "",
    "Port": 587,
    "SenderName": "FlashBite Delivery",
    "SenderEmail": "",
    "Username": "",
    "Password": "",
    "EnableSsl": true
  }
}
